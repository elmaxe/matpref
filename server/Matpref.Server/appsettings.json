{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Matpref": {
    "DatabasePath": "/data/matpref.db",
    "Token": "",
    "AllowedOrigins": [ "https://elmaxe.github.io", "http://localhost:5173" ]
  },
  "Import": {
    "Enabled": true,
    "IntervalHours": 12,
    "TargetUnswiped": 150,
    "MaxNewPerSource": 40,
    "DelayMs": 1500,
    "Sources": [
      {
        "Name": "ICA",
        "Sitemaps": [ "https://www.ica.se/recept/sitemaps/" ],
        "SitemapPattern": "/recept/sitemaps/recipes/",
        "UrlPattern": "^https://www\\.ica\\.se/recept/[^/]+-\\d+/$"
      },
      {
        "Name": "Arla",
        "Sitemaps": [ "https://www.arla.se/sitemap.xml?type=Modules.Recipes.Business.SitemapUrlWriter.RecipeSitemapUrlWriter" ],
        "UrlPattern": "^https://www\\.arla\\.se/recept/[^/]+/$"
      },
      {
        "Name": "Coop",
        "Sitemaps": [ "https://www.coop.se/recept/sitemap.xml" ],
        "UrlPattern": "^https://www\\.coop\\.se/recept/[^/?]+/?$"
      },
      {
        "Name": "Köket.se",
        "Sitemaps": [ "https://www.koket.se/sitemap.xml" ]
      }
    ]
  }
}
